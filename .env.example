# Dynamis Tracker — environment variables.
# NEVER commit real secrets. Copy to .env for local development: cp .env.example .env
#
# Backend database (Neon PostgreSQL). SERVER-SIDE ONLY — the browser bundle
# must never contain this value (no VITE_ prefix, never imported by src/).
# Get yours from https://neon.tech → New project → Connection Details.

# Neon PostgreSQL connection string
DATABASE_URL=

# Signs session cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required whenever the API runs (local dev included).
JWT_SECRET=

# Optional: expose password-reset tokens in API responses for local testing.
# NEVER enable in production (no SMTP is configured by default).
# ALLOW_DEV_RESET=true

# Private admin login — server-side only, never VITE_-prefixed.
# Run `ADMIN_INITIAL_PASSWORD=... npm run admin:provision` once, then remove
# the initial password from the environment. Authentication reads Neon only.
ADMIN_SESSION_SECRET=
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
